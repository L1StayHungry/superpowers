{"type":"item.completed","item":{"id":"item_34","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,220p' tools/t-archive-precheck\"","aggregated_output":"#!/usr/bin/env python3\nfrom pathlib import Path\nimport json\nimport re\nimport subprocess\nimport sys\n\nROOT = Path(__file__).resolve().parents[1]\nSPECS_ROOT = (ROOT / \"docsDev/specs\").resolve(strict=False)\ndef die(code, message):\n    print(f\"FAIL[{code}]: {message}\", file=sys.stderr)\n    return code\ndef field(pattern, body):\n    match = re.search(pattern, body, re.MULTILINE)\n    return match.group(1).strip() if match else None\ndef archive_patch_sections(text):\n    match = re.search(r\"(?m)^## Archive Patch\\s*$\", text)\n    if not match:\n        raise ValueError(\"Archive Patch block is missing\")\n    block = text[match.end():]\n    if re.search(r\"(?m)^##\\s+\\S\", block):\n        raise ValueError(\"Archive Patch must be terminal\")\n    if re.search(r\"(?m)^###\\s*$\", block):\n        raise ValueError(\"Archive Patch has empty capability heading\")\n    headings = list(re.finditer(r\"(?m)^###\\s+(\\S.*?)\\s*$\", block))\n    if not headings:\n        raise ValueError(\"Archive Patch has no capability sections\")\n    return [\n        (heading.group(1), block[heading.end():headings[i + 1].start() if i + 1 < len(headings) else None])\n        for i, heading in enumerate(headings)\n    ]\ndef section_metadata(section):\n    capability, body = section\n    target = field(r\"^Target:\\s*(.+?)\\s*$\", body)\n    action = field(r\"^Action:\\s*(\\S+)\\s*$\", body)\n    if not target:\n        raise ValueError(f\"{capability}: missing Target\")\n    if action not in {\"create\", \"update\"}:\n        raise ValueError(f\"{capability}: Action must be create or update\")\n    if not re.search(r\"(?m)^#{5}\\s+Requirement:\\s*\\S\", body):\n        raise ValueError(f\"{capability}: missing Requirement\")\n    if not re.search(r\"(?m)^#{6}\\s+Scenario:\\s*\\S\", body):\n        raise ValueError(f\"{capability}: missing Scenario\")\n    return {\"capability\": capability, \"target\": target, \"action\": action}\ndef target_code(raw_target):\n    raw_path = Path(raw_target)\n    if raw_path.is_absolute():\n        return die(3, f\"Archive Patch Target must be relative: {raw_target}\")\n    if \"..\" in raw_path.parts:\n        return die(3, f\"Archive Patch Target must not contain ..: {raw_target}\")\n    resolved = (ROOT / raw_target).resolve(strict=False)\n    if resolved == SPECS_ROOT:\n        return die(3, f\"Archive Patch Target must not equal specs root: {raw_target}\")\n    try:\n        resolved.relative_to(SPECS_ROOT)\n    except ValueError:\n        return die(3, f\"Archive Patch Target escapes docsDev/specs: {raw_target}\")\n    return 0\ndef main():\n    if len(sys.argv) != 2:\n        return die(1, \"usage: tools/t-archive-precheck <change-id>\")\n    change_id = sys.argv[1]\n    if not re.fullmatch(r\"\\d{8}-[a-z0-9-]{3,40}\", change_id):\n        return die(1, \"change-id must match YYYYMMDD-<lowercase-slug>\")\n    change_dir = ROOT / \"docsDev/changes\" / change_id\n    spec_path = change_dir / \"spec.md\"\n    if not change_dir.is_dir():\n        return die(1, f\"missing change directory: {change_dir}\")\n    if not spec_path.is_file():\n        return die(1, f\"missing spec.md: {spec_path}\")\n\n    try:\n        text = spec_path.read_text(encoding=\"utf-8\")\n        patches = [section_metadata(section) for section in archive_patch_sections(text)]\n    except ValueError as exc:\n        return die(2, str(exc))\n\n    for patch in patches:\n        code = target_code(patch[\"target\"])\n        if code:\n            return code\n\n    archive_dir = ROOT / \"docsDev/archive\" / change_id\n    if archive_dir.exists():\n        return die(4, f\"archive destination already exists: {archive_dir}\")\n\n    status = subprocess.run([\"git\", \"status\", \"--porcelain\"], cwd=ROOT, text=True, capture_output=True)\n    if status.returncode != 0:\n        return die(5, status.stderr.strip() or \"git status failed\")\n    if status.stdout.strip():\n        return die(5, \"working tree is not clean\")\n\n    print(json.dumps({\"change_id\": change_id, \"archive_patches\": patches}, ensure_ascii=False))\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n","exit_code":0,"status":"completed"}}
