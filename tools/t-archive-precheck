#!/usr/bin/env python3
from pathlib import Path
import json
import re
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[1]
SPECS_ROOT = (ROOT / "docsDev/specs").resolve(strict=False)
def die(code, message):
    print(f"FAIL[{code}]: {message}", file=sys.stderr)
    return code
def field(pattern, body):
    match = re.search(pattern, body, re.MULTILINE)
    return match.group(1).strip() if match else None
def archive_patch_sections(text):
    match = re.search(r"(?m)^## Archive Patch\s*$", text)
    if not match:
        raise ValueError("Archive Patch block is missing")
    block = text[match.end():]
    if re.search(r"(?m)^##\s+\S", block):
        raise ValueError("Archive Patch must be terminal")
    if re.search(r"(?m)^###\s*$", block):
        raise ValueError("Archive Patch has empty capability heading")
    headings = list(re.finditer(r"(?m)^###\s+(\S.*?)\s*$", block))
    if not headings:
        raise ValueError("Archive Patch has no capability sections")
    return [
        (heading.group(1), block[heading.end():headings[i + 1].start() if i + 1 < len(headings) else None])
        for i, heading in enumerate(headings)
    ]
def section_metadata(section):
    capability, body = section
    target = field(r"^Target:\s*(.+?)\s*$", body)
    action = field(r"^Action:\s*(\S+)\s*$", body)
    if not target:
        raise ValueError(f"{capability}: missing Target")
    if action not in {"create", "update"}:
        raise ValueError(f"{capability}: Action must be create or update")
    if not re.search(r"(?m)^#{5}\s+Requirement:\s*\S", body):
        raise ValueError(f"{capability}: missing Requirement")
    if not re.search(r"(?m)^#{6}\s+Scenario:\s*\S", body):
        raise ValueError(f"{capability}: missing Scenario")
    return {"capability": capability, "target": target, "action": action}
def target_code(raw_target):
    raw_path = Path(raw_target)
    if raw_path.is_absolute():
        return die(3, f"Archive Patch Target must be relative: {raw_target}")
    if ".." in raw_path.parts:
        return die(3, f"Archive Patch Target must not contain ..: {raw_target}")
    resolved = (ROOT / raw_target).resolve(strict=False)
    if resolved == SPECS_ROOT:
        return die(3, f"Archive Patch Target must not equal specs root: {raw_target}")
    try:
        resolved.relative_to(SPECS_ROOT)
    except ValueError:
        return die(3, f"Archive Patch Target escapes docsDev/specs: {raw_target}")
    return 0
def main():
    if len(sys.argv) != 2:
        return die(1, "usage: tools/t-archive-precheck <change-id>")
    change_id = sys.argv[1]
    if not re.fullmatch(r"\d{8}-[a-z0-9-]{3,40}", change_id):
        return die(1, "change-id must match YYYYMMDD-<lowercase-slug>")
    change_dir = ROOT / "docsDev/changes" / change_id
    spec_path = change_dir / "spec.md"
    if not change_dir.is_dir():
        return die(1, f"missing change directory: {change_dir}")
    if not spec_path.is_file():
        return die(1, f"missing spec.md: {spec_path}")

    try:
        text = spec_path.read_text(encoding="utf-8")
        patches = [section_metadata(section) for section in archive_patch_sections(text)]
    except ValueError as exc:
        return die(2, str(exc))

    for patch in patches:
        code = target_code(patch["target"])
        if code:
            return code

    archive_dir = ROOT / "docsDev/archive" / change_id
    if archive_dir.exists():
        return die(4, f"archive destination already exists: {archive_dir}")

    status = subprocess.run(["git", "status", "--porcelain"], cwd=ROOT, text=True, capture_output=True)
    if status.returncode != 0:
        return die(5, status.stderr.strip() or "git status failed")
    if status.stdout.strip():
        return die(5, "working tree is not clean")

    print(json.dumps({"change_id": change_id, "archive_patches": patches}, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    sys.exit(main())
